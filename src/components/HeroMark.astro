---
// Decorative AK mark for the hero (≥ 960px only). Pure CSS, no client JS.
// 1. Facets assemble once on load.
// 2. Then a 9s loop: rest (the mark gently breathes) → facets drift out a third
//    of the way along their assembly paths → hang → spring back → a visible
//    light sweep runs left to right as they lock in.
---

<svg
  class="hero-mark"
  viewBox="0 0 276 216"
  aria-hidden="true"
  focusable="false"
>
  <g class="breathe">
    <!-- Base facets (slightly overlapped so there are no seams) -->
    <polygon class="facet facet--left" points="108,0 0,216 60,216 84,168 108.8,168 108.8,1.6"></polygon>
    <polygon class="facet facet--k-upper" points="216,0 276,0 221.6,108.8 161.6,108.8"></polygon>
    <polygon class="facet facet--right" points="108,0 162,108 216.8,216 156,216 132,168 108,168"></polygon>
    <polygon class="facet facet--k-lower" points="162,108 222,108 276,216 216,216"></polygon>

    <!-- Highlight overlays, swept left → right -->
    <polygon class="glint glint--1" points="108,0 0,216 60,216 84,168 108,168"></polygon>
    <polygon class="glint glint--2" points="108,0 162,108 216,216 156,216 132,168 108,168"></polygon>
    <polygon class="glint glint--3" points="216,0 276,0 222,108 162,108"></polygon>
    <polygon class="glint glint--4" points="162,108 222,108 276,216 216,216"></polygon>
  </g>
</svg>

<style>
  .hero-mark {
    display: none;
  }

  @media (min-width: 960px) {
    .hero-mark {
      display: block;
      /* Box is reserved up front, so the animation causes no layout shift */
      width: clamp(220px, 26vw, 340px);
      height: auto;
      aspect-ratio: 276 / 216;
      overflow: visible;
    }
  }

  .breathe,
  .facet,
  .glint {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Gentle idle "breathing" of the whole mark */
  .breathe {
    animation: breathe 4.5s ease-in-out 2s infinite alternate;
  }

  /* Assemble once, then loop "escape and return" (starts after assembly) */
  .facet {
    animation:
      assemble 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      escape 9s linear infinite;
  }

  .facet--left {
    fill: var(--ak-sky-300);
    --dx: -24px;
    --dy: 48px;
    animation-delay: 0s, 2s;
  }

  .facet--right {
    fill: var(--ak-sky-100);
    --dx: 24px;
    --dy: 48px;
    animation-delay: 0.12s, 2.06s;
  }

  .facet--k-upper {
    fill: var(--ak-sky-300);
    --dx: 24px;
    --dy: -48px;
    animation-delay: 0.25s, 2.12s;
  }

  .facet--k-lower {
    fill: var(--ak-sky-500);
    --dx: 24px;
    --dy: 48px;
    animation-delay: 0.38s, 2.18s;
  }

  .glint {
    fill: var(--ak-highlight);
    opacity: 0;
    animation: sweep 9s ease-in-out infinite;
  }

  /* Each glint fires as its facet locks back in, left → right */
  .glint--1 {
    animation-delay: 2s;
  }

  .glint--2 {
    animation-delay: 2.12s;
  }

  .glint--3 {
    animation-delay: 2.24s;
  }

  .glint--4 {
    animation-delay: 2.36s;
  }

  @keyframes assemble {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* 0–55% rest · 55–70% drift out ⅓ · 70–76% hang · 76–86% spring back with a
     small overshoot · 86–92% settle */
  @keyframes escape {
    0%,
    55% {
      transform: none;
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    70% {
      transform: translate(calc(var(--dx) / 3), calc(var(--dy) / 3));
      animation-timing-function: ease-in-out;
    }
    76% {
      transform: translate(calc(var(--dx) / 2.7), calc(var(--dy) / 2.7));
      animation-timing-function: cubic-bezier(0.5, 0, 0.2, 1);
    }
    86% {
      transform: translate(calc(var(--dx) * -0.06), calc(var(--dy) * -0.06));
      animation-timing-function: ease-out;
    }
    92%,
    100% {
      transform: none;
    }
  }

  @keyframes sweep {
    0%,
    88% {
      opacity: 0;
    }
    92% {
      opacity: 0.35;
    }
    98%,
    100% {
      opacity: 0;
    }
  }

  @keyframes breathe {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.025);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breathe,
    .facet,
    .glint {
      animation: none;
    }

    .breathe,
    .facet {
      opacity: 1;
      transform: none;
    }

    .glint {
      opacity: 0;
    }
  }
</style>
