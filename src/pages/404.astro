---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`Page not found — ${site.name.first} ${site.name.last}`} description={site.notFound.text} noindex>
  <div class="container">
    <Header homeHref={home} navBase={home} />
    <main class="not-found">
      <h1>{site.notFound.heading}</h1>
      <p>{site.notFound.text}</p>
      <a href={home}>{site.notFound.linkLabel}</a>
    </main>
  </div>
</Base>

<style>
  .not-found {
    padding: clamp(72px, 14vw, 160px) 0 clamp(72px, 12vw, 136px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  h1 {
    margin: 0;
    font-family: var(--ak-font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.95;
  }

  p {
    margin: 0;
    color: var(--color-body-2);
  }
</style>
